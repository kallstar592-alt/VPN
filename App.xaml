<Application x:Class="VPN.App" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" StartupUri="MainWindow.xaml">
  <Application.Resources>
    <SolidColorBrush x:Key="Bg" Color="#0B0D12"/>
    <SolidColorBrush x:Key="Panel" Color="#131720"/>
    <SolidColorBrush x:Key="Panel2" Color="#191E29"/>
    <SolidColorBrush x:Key="Text" Color="#F4F6FA"/>
    <SolidColorBrush x:Key="Muted" Color="#8D96A8"/>
    <SolidColorBrush x:Key="Accent" Color="#B86BFF"/>
    <SolidColorBrush x:Key="Green" Color="#55D98B"/>
    <Style TargetType="TextBlock"><Setter Property="Foreground" Value="{StaticResource Text}"/></Style>
    <Style TargetType="Button">
      <Setter Property="Foreground" Value="{StaticResource Text}"/><Setter Property="Background" Value="{StaticResource Panel2}"/>
      <Setter Property="BorderBrush" Value="#2B3342"/><Setter Property="Padding" Value="14,9"/><Setter Property="Margin" Value="4"/>
    </Style>
    <Style TargetType="ComboBox"><Setter Property="Foreground" Value="#11131A"/><Setter Property="Margin" Value="4"/></Style>
    <Style TargetType="TextBox"><Setter Property="Foreground" Value="#11131A"/><Setter Property="Margin" Value="4"/><Setter Property="Padding" Value="8"/></Style>
    <Style TargetType="CheckBox"><Setter Property="Foreground" Value="{StaticResource Text}"/><Setter Property="Margin" Value="4,8"/></Style>
  </Application.Resources>
</Application>
