<Window x:Class="VPN.MainWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Title="VPN" Width="980" Height="650" MinWidth="850" MinHeight="560" Background="{StaticResource Bg}">
  <Grid Margin="28">
    <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
    <DockPanel Grid.Row="0" Margin="0,0,0,22">
      <StackPanel DockPanel.Dock="Left"><TextBlock Text="VPN" FontSize="30" FontWeight="Bold"/><TextBlock Text="Secure Windows VPN Client" Foreground="{StaticResource Muted}" Margin="0,2,0,0"/></StackPanel>
      <TextBlock x:Name="StatusText" DockPanel.Dock="Right" Text="● DISCONNECTED" Foreground="{StaticResource Muted}" FontWeight="SemiBold" VerticalAlignment="Center"/>
    </DockPanel>

    <Border Grid.Row="1" Background="{StaticResource Panel}" CornerRadius="14" Padding="18" Margin="0,0,0,18">
      <Grid>
        <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="180"/><ColumnDefinition Width="150"/></Grid.ColumnDefinitions>
        <StackPanel>
          <TextBlock Text="Connection mode" Foreground="{StaticResource Muted}"/>
          <ComboBox x:Name="ModeBox" SelectedIndex="0" SelectionChanged="ModeChanged">
            <ComboBoxItem Content="AUTO — best configured server"/>
            <ComboBoxItem Content="IKEv2"/>
            <ComboBoxItem Content="OpenVPN"/>
          </ComboBox>
        </StackPanel>
        <StackPanel Grid.Column="1" Margin="15,0,0,0">
          <TextBlock Text="Profile" Foreground="{StaticResource Muted}"/>
          <ComboBox x:Name="ProfileBox" DisplayMemberPath="Name" SelectionChanged="ProfileChanged"/>
        </StackPanel>
        <Button Grid.Column="2" Content="＋ Add profile" Click="AddProfile_Click" VerticalAlignment="Bottom" Height="40"/>
      </Grid>
    </Border>

    <Grid Grid.Row="2">
      <Grid.ColumnDefinitions><ColumnDefinition Width="2*"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
      <Border Grid.Column="0" Background="{StaticResource Panel}" CornerRadius="18" Padding="28" Margin="0,0,12,0">
        <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
          <TextBlock x:Name="ServerText" Text="No server selected" FontSize="20" HorizontalAlignment="Center"/>
          <TextBlock x:Name="LatencyText" Text="Add a profile to begin" Foreground="{StaticResource Muted}" FontSize="14" HorizontalAlignment="Center" Margin="0,7,0,25"/>
          <Button x:Name="ConnectButton" Content="CONNECT" Click="Connect_Click" Width="230" Height="64" FontSize="19" FontWeight="Bold" Background="{StaticResource Accent}"/>
          <TextBlock Text="Your VPN provider/server must supply a compatible configuration." Foreground="{StaticResource Muted}" TextWrapping="Wrap" Width="330" TextAlignment="Center" Margin="0,18,0,0"/>
        </StackPanel>
      </Border>

      <Border Grid.Column="1" Background="{StaticResource Panel}" CornerRadius="18" Padding="22" Margin="12,0,0,0">
        <StackPanel>
          <TextBlock Text="Settings" FontSize="19" FontWeight="SemiBold" Margin="0,0,0,10"/>
          <CheckBox x:Name="KillSwitchBox" Content="Kill switch"/>
          <TextBlock Text="Blocks traffic when the VPN tunnel drops. The filtering layer is reserved for the privileged Windows service in the next build." Foreground="{StaticResource Muted}" TextWrapping="Wrap" FontSize="12"/>
          <CheckBox x:Name="ReconnectBox" Content="Auto reconnect"/>
          <Separator Margin="0,12"/>
          <TextBlock Text="Supported" FontWeight="SemiBold"/>
          <TextBlock Text="• OpenVPN .ovpn profiles\n• Windows IKEv2 profiles\n• Auto server selection\n• Ping/latency checks" Foreground="{StaticResource Muted}" Margin="0,7,0,0"/>
          <Button Content="Remove selected profile" Click="RemoveProfile_Click" Margin="0,20,0,0"/>
        </StackPanel>
      </Border>
    </Grid>
    <TextBlock Grid.Row="3" Text="VPN • Windows 10/11 • .NET 8" Foreground="{StaticResource Muted}" HorizontalAlignment="Right" Margin="0,15,0,0"/>
  </Grid>
</Window>
