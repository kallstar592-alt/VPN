<Window x:Class="VPN.MainWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Title="VPN" Width="1220" Height="820" MinWidth="1040" MinHeight="700" Background="{StaticResource Bg}" WindowStartupLocation="CenterScreen">
  <Grid Margin="24">
    <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
    <Grid Grid.Row="0" Margin="0,0,0,18">
      <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
      <StackPanel>
        <StackPanel Orientation="Horizontal">
          <Border Width="34" Height="34" CornerRadius="10" Background="{StaticResource Accent}" VerticalAlignment="Center"><TextBlock Text="V" FontSize="21" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center"/></Border>
          <TextBlock Text="VPN" FontSize="29" FontWeight="Bold" Margin="12,0,0,0" VerticalAlignment="Center"/>
          <Border Background="{StaticResource Panel2}" CornerRadius="8" Padding="9,4" Margin="12,0,0,0" VerticalAlignment="Center"><TextBlock Text="WINDOWS CLIENT" FontSize="10" FontWeight="Bold" Foreground="{StaticResource Muted}"/></Border>
        </StackPanel>
        <TextBlock Text="One place to manage your configured VPN connections." Foreground="{StaticResource Muted}" Margin="2,5,0,0"/>
      </StackPanel>
      <StackPanel Grid.Column="1" HorizontalAlignment="Right" VerticalAlignment="Center">
        <TextBlock x:Name="StatusText" Text="● DISCONNECTED" Foreground="{StaticResource Muted}" FontWeight="SemiBold" HorizontalAlignment="Right"/>
        <TextBlock x:Name="StatusDetailText" Text="Ready to connect" Foreground="{StaticResource Muted}" FontSize="11" Margin="0,4,0,0" HorizontalAlignment="Right"/>
      </StackPanel>
    </Grid>
    <Grid Grid.Row="1">
      <Grid.ColumnDefinitions><ColumnDefinition Width="255"/><ColumnDefinition Width="18"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
      <Border Grid.Column="0" Background="{StaticResource Panel}" CornerRadius="16" Padding="14">
        <Grid>
          <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
          <TextBlock Text="REFERENCE LOCATIONS" FontSize="11" FontWeight="Bold" Foreground="{StaticResource Muted}" Margin="4,3,0,11"/>
          <TextBlock Grid.Row="1" Text="Choose a region" FontSize="18" FontWeight="SemiBold" Margin="4,0,0,10"/>
          <ListBox x:Name="LocationList" Grid.Row="2" Background="Transparent" BorderThickness="0" SelectionChanged="LocationChanged" ScrollViewer.VerticalScrollBarVisibility="Auto">
            <ListBox.ItemTemplate><DataTemplate><Border Padding="10" Margin="0,3" CornerRadius="10" Background="{StaticResource Panel2}"><StackPanel><TextBlock Text="{Binding DisplayName}" FontWeight="SemiBold" FontSize="13"/><TextBlock Text="{Binding Description}" Foreground="{StaticResource Muted}" FontSize="11" TextWrapping="Wrap" Margin="0,4,0,0"/></StackPanel></Border></DataTemplate></ListBox.ItemTemplate>
          </ListBox>
          <StackPanel Grid.Row="3" Margin="2,14,2,0">
            <TextBlock Text="These are location presets, not live VPN servers." Foreground="{StaticResource Muted}" FontSize="11" TextWrapping="Wrap"/>
            <Button Content="＋ Add profile for region" Click="AddProfile_Click" Height="38" Margin="0,10,0,0" Background="{StaticResource Accent}"/>
          </StackPanel>
        </Grid>
      </Border>
      <Grid Grid.Column="2">
        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
        <Border Grid.Row="0" Background="{StaticResource Panel}" CornerRadius="16" Padding="22" Margin="0,0,0,16">
          <Grid>
            <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
            <StackPanel VerticalAlignment="Center">
              <TextBlock Text="CURRENT CONNECTION" Foreground="{StaticResource Muted}" FontSize="11" FontWeight="Bold"/>
              <TextBlock x:Name="ServerText" Text="No configured server selected" FontSize="23" FontWeight="Bold" Margin="0,8,0,0"/>
              <TextBlock x:Name="LatencyText" Text="Import a provider profile to begin" Foreground="{StaticResource Muted}" Margin="0,6,0,0" TextWrapping="Wrap"/>
              <StackPanel Orientation="Horizontal" Margin="0,16,0,0">
                <TextBlock Text="MODE" FontSize="10" Foreground="{StaticResource Muted}" FontWeight="Bold" VerticalAlignment="Center"/>
                <ComboBox x:Name="ModeBox" Width="235" SelectedIndex="0" SelectionChanged="ModeChanged" Margin="8,0,0,0">
                  <ComboBoxItem Content="AUTO — lowest measured latency"/><ComboBoxItem Content="IKEv2"/><ComboBoxItem Content="OpenVPN"/>
                </ComboBox>
              </StackPanel>
            </StackPanel>
            <StackPanel Grid.Column="1" VerticalAlignment="Center" HorizontalAlignment="Right" Margin="20,0,0,0">
              <Button x:Name="ConnectButton" Content="CONNECT" Click="Connect_Click" Width="190" Height="58" FontSize="17" FontWeight="Bold" Background="{StaticResource Accent}"/>
              <TextBlock Text="Connection requires a real provider profile." Foreground="{StaticResource Muted}" FontSize="10" Width="190" TextWrapping="Wrap" TextAlignment="Center" Margin="0,7,0,0"/>
            </StackPanel>
          </Grid>
        </Border>
        <Grid Grid.Row="1">
          <Grid.ColumnDefinitions><ColumnDefinition Width="1.15*"/><ColumnDefinition Width="16"/><ColumnDefinition Width="0.85*"/></Grid.ColumnDefinitions>
          <Border Grid.Column="0" Background="{StaticResource Panel}" CornerRadius="16" Padding="18">
            <Grid><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
              <TextBlock Text="Configured profiles" FontSize="18" FontWeight="SemiBold"/>
              <TextBlock Grid.Row="1" Text="Real endpoints imported from your VPN provider" Foreground="{StaticResource Muted}" FontSize="11" Margin="0,4,0,10"/>
              <ListBox x:Name="ProfileBox" Grid.Row="2" DisplayMemberPath="Name" SelectionChanged="ProfileChanged" Background="{StaticResource Panel2}" BorderThickness="0"/>
              <StackPanel Grid.Row="3" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,12,0,0"><Button Content="＋ Add" Click="AddProfile_Click"/><Button Content="Remove" Click="RemoveProfile_Click"/></StackPanel>
            </Grid>
          </Border>
          <Border Grid.Column="2" Background="{StaticResource Panel}" CornerRadius="16" Padding="18">
            <ScrollViewer VerticalScrollBarVisibility="Auto"><StackPanel>
              <TextBlock Text="Protection &amp; settings" FontSize="18" FontWeight="SemiBold" Margin="0,0,0,12"/>
              <Border Background="{StaticResource Panel2}" CornerRadius="12" Padding="12"><StackPanel>
                <CheckBox x:Name="KillSwitchBox" Content="Firewall kill switch (OpenVPN)" Checked="KillSwitchBox_Checked" Unchecked="KillSwitchBox_Unchecked"/>
                <TextBlock x:Name="KillSwitchDetailText" Text="Arms Windows Firewall after an OpenVPN tunnel is established. Administrator access is required." Foreground="{StaticResource Muted}" FontSize="11" TextWrapping="Wrap" Margin="4,4,4,0"/>
              </StackPanel></Border>
              <CheckBox x:Name="ReconnectBox" Content="Auto-reconnect if OpenVPN drops" IsChecked="True" Margin="0,13,0,8"/>
              <Separator Margin="0,8"/>
              <TextBlock Text="Protocols" FontWeight="SemiBold"/>
              <TextBlock Text="OpenVPN .ovpn profiles" Foreground="{StaticResource Muted}" FontSize="12" Margin="0,7,0,0"/>
              <TextBlock Text="Windows IKEv2 profiles" Foreground="{StaticResource Muted}" FontSize="12" Margin="0,4,0,0"/>
              <TextBlock Text="Auto mode measures configured endpoints only" Foreground="{StaticResource Muted}" FontSize="12" TextWrapping="Wrap" Margin="0,4,0,0"/>
              <Separator Margin="0,13"/>
              <TextBlock Text="Server setup" FontWeight="SemiBold"/>
              <TextBlock Text="Select a reference region, then add the actual hostname and provider configuration. Empty presets never attempt to connect." Foreground="{StaticResource Muted}" FontSize="11" TextWrapping="Wrap" Margin="0,6,0,0"/>
              <Button Content="Import / manage profile" Click="AddProfile_Click" Margin="0,12,0,0"/>
              <Button Content="Restore firewall / disable kill switch" Click="RestoreFirewall_Click" Margin="0,5,0,0"/>
            </StackPanel></ScrollViewer>
          </Border>
        </Grid>
      </Grid>
    </Grid>
    <Grid Grid.Row="2" Margin="0,14,0,0"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
      <TextBlock Text="VPN • Windows 10/11 • .NET 8" Foreground="{StaticResource Muted}" FontSize="11"/>
      <TextBlock Grid.Column="1" Text="US West • US Central • US East • Singapore" Foreground="{StaticResource Muted}" FontSize="11"/>
    </Grid>
  </Grid>
</Window>